# Google Cloud Platform Environment Variables for Contents Platform

# Project configuration
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"

# Cloud Run Configuration
SERVICE_NAME="contents-api"
MIN_INSTANCES=0
MAX_INSTANCES=5
CPU="1"
MEMORY="512Mi"

# Application Security
SECRET_KEY="generate-a-strong-random-secret-key-here"
DEBUG="False"
ALLOWED_HOSTS="*"
CORS_ALLOW_ALL="False"

# Cloud SQL PostgreSQL Connection
# Format: postgresql://<USER>:<PASSWORD>@<CLOUD_SQL_IP>:5432/<DATABASE>
# Or via Unix Socket: postgresql://<USER>:<PASSWORD>@/<DATABASE>?host=/cloudsql/<CONNECTION_NAME>
DATABASE_URL="postgresql://contents_user:your-secure-password@/contents_db?host=/cloudsql/your-gcp-project:us-central1:atria-sql-primary"

# Companion Service Secrets (Optional)
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
GEMINI_API_KEY=""
